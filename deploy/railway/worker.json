{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "docker/api.Dockerfile",
    "watchPatterns": ["src/**", "pyproject.toml", "uv.lock", "docker/api.Dockerfile"]
  },
  "deploy": {
    "startCommand": "python -m sdr.worker",
    "restartPolicyType": "ALWAYS"
  }
}
