{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "docker/api.Dockerfile",
    "watchPatterns": [
      "src/**",
      "migrations/**",
      "alembic.ini",
      "pyproject.toml",
      "uv.lock",
      "docker/api.Dockerfile"
    ]
  },
  "deploy": {
    "preDeployCommand": [
      "sh -c 'alembic upgrade head && python -m sdr.cli seed'"
    ],
    "startCommand": "sh -c 'exec uvicorn sdr.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips=*'",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
