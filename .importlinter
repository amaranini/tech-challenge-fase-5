[importlinter]
root_packages =
    sdr
    web
include_external_packages = True

# 1. Camadas globais. `verticals` e `config` não se conhecem: a vertical tem config própria
#    e o bootstrap é quem escolhe e monta a vertical ativa.
[importlinter:contract:camadas-globais]
name = Camadas globais (core <- verticals <- bootstrap <- main/cli)
type = layers
layers =
    sdr.main | sdr.cli
    sdr.bootstrap
    sdr.verticals | sdr.config
    sdr.core

# 2. O core é genérico: nunca conhece uma vertical.
[importlinter:contract:core-agnostico]
name = Core não importa verticals
type = forbidden
source_modules =
    sdr.core
forbidden_modules =
    sdr.verticals

# 3. Hexágono do core: cada camada só importa as de baixo.
#    `vertical` (contrato VerticalPack) fica no topo porque referencia infra (FastAPI, sessões).
[importlinter:contract:camadas-core]
name = Hexágono do core (domain <- application <- adapters <- vertical)
type = layers
containers =
    sdr.core
layers =
    vertical
    adapters
    application
    domain

# 4. Hexágono de cada fatia da vertical + pack no topo da vertical.
[importlinter:contract:camadas-vertical-imobiliario]
name = Vertical imobiliária (pack <- config | catalogo | persona)
type = layers
containers =
    sdr.verticals.imobiliario
layers =
    pack
    config | catalogo | persona

[importlinter:contract:camadas-fatias-imobiliario]
name = Hexágono das fatias da vertical imobiliária (domain <- application <- adapters)
type = layers
containers =
    sdr.verticals.imobiliario.catalogo
layers =
    adapters
    application
    domain

# 5. Núcleos puros (domain + application do core e das fatias): sem frameworks/infra.
[importlinter:contract:nucleo-puro]
name = Núcleos não importam frameworks/infra
type = forbidden
source_modules =
    sdr.core.domain
    sdr.core.application
    sdr.verticals.imobiliario.catalogo.domain
    sdr.verticals.imobiliario.catalogo.application
forbidden_modules =
    fastapi
    starlette
    pydantic
    pydantic_settings
    sqlalchemy
    psycopg
    alembic
    streamlit
    httpx
    uvicorn
    fastembed
    onnxruntime
    numpy
    pgvector
    openai
    langgraph
    langchain_core

# 6. Adapters de entrada e de saída do core não se conhecem.
[importlinter:contract:adapters-independentes]
name = Adapters inbound e outbound do core são independentes
type = independence
modules =
    sdr.core.adapters.inbound
    sdr.core.adapters.outbound

# 7. O front Streamlit fala com o backend SOMENTE via HTTP.
[importlinter:contract:web-isolado]
name = web não importa o backend
type = forbidden
source_modules =
    web
forbidden_modules =
    sdr
    sqlalchemy
    psycopg
