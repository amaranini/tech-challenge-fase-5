# Copie para .env e ajuste. NUNCA commite o .env.
# Na nuvem (Railway), as mesmas variáveis vão em Variables de cada serviço: veja
# docs/deploy.md (o que vai na api/worker e o que vai no web).

# local | producao (producao: sem /demo e /docs; exige ADMIN_API_KEYS e login do dashboard)
AMBIENTE=local
# DEBUG | INFO | WARNING (logs sempre com PII mascarada)
LOG_LEVEL=INFO

# Postgres (docker compose)
POSTGRES_USER=sdr
POSTGRES_PASSWORD=sdr
POSTGRES_DB=sdr
DB_PORT=5433

# Usado pela API/migrations/testes rodando no host.
# Dentro do compose a API recebe a URL apontando para o serviço "db".
# Nuvem: ${{pgvector.DATABASE_URL}} (postgres:// ou postgresql:// viram o driver async).
DATABASE_URL=postgresql+psycopg://sdr:sdr@localhost:5433/sdr

# Portas expostas no host (docker compose)
API_PORT=8000
WEB_PORT=8501
# Nuvem: porta em que o processo escuta (a plataforma define; na api fixe 8000)
# PORT=8000

# Embeddings locais (fastembed). Trocar o modelo para outra dimensão exige migration.
EMBEDDING_MODELO=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSAO=384
# Onde fica o modelo. Local (host): .cache/fastembed. Nas imagens Docker é /models (o
# modelo vem no build) — NÃO defina esta variável na nuvem.
EMBEDDING_CACHE_DIR=.cache/fastembed
# Carrega o modelo no start da API (1ª busca sem espera); o compose e a nuvem usam true
EMBEDDING_CARREGAR_NO_INICIO=false

# Vertical de negócio ativa
VERTICAL=imobiliario

# --- Vertical imobiliária (prefixo IMOBILIARIO_) ---
# O que "perto do metrô" significa na busca (metros)
IMOBILIARIO_DISTANCIA_METRO_PADRAO_M=1000
# Versão do prompt da persona (persona/prompts/<versao>.md)
IMOBILIARIO_VERSAO_PROMPT=lia_v2

# --- LLM (Etapa C) ---
# Provedor do LLMPort (hoje: openai)
LLM_PROVIDER=openai
# Modelo com suporte a tool calling; confira os disponíveis na sua conta
LLM_MODELO=gpt-4.1-mini
# Modelo por nó do grafo (vazio = usa LLM_MODELO)
LLM_MODEL_ROUTER=
LLM_MODEL_EXTRACTION=
LLM_MODEL_AGENT=
# Resumo para o responsável (gerado fora do turno)
LLM_MODEL_SUMMARY=
# Turnos assíncronos: espera o lead parar de digitar (reinicia a cada mensagem), com teto
DEBOUNCE_SEGUNDOS=5
DEBOUNCE_MAX_SEGUNDOS=20
# Confiança mínima do roteador para trocar de intenção
ROUTER_CONFIANCA_MIN=0.6
# Temperatura das respostas (classificadores usam saída estruturada)
LLM_TEMPERATURA=0.4
# Tempo máximo de cada chamada ao LLM (s)
LLM_TIMEOUT_S=40
# Rodadas LLM ↔ ferramentas por turno; mensagens de histórico para o agente; mensagens
# recentes lidas por roteador/extração
AGENTE_MAX_PASSOS=4
CONVERSA_JANELA_HISTORICO=30
EXTRACAO_JANELA_MENSAGENS=6
# Chave da OpenAI (https://platform.openai.com/api-keys) — NUNCA commitar
OPENAI_API_KEY=

# --- Operação (vale para qualquer vertical) ---
FUSO_OPERACAO=America/Sao_Paulo
# Horário de atendimento da equipe (handoff para humano): dias e faixas no fuso acima
ATENDIMENTO_DIAS=seg-sex
ATENDIMENTO_FAIXAS=09:00-18:00

# --- Agenda (Dia 3) ---
# Não oferece horário mais próximo que N horas, nem além de N dias
AGENDA_ANTECEDENCIA_HORAS=2
AGENDA_JANELA_DIAS=14
# Quantos horários a Lia propõe por vez
AGENDA_SUGESTOES=3
# Agenda mock (Postgres): grade gerada no start da API e no `make seed`.
# Em produção: Google Calendar / Outlook (troca-se o adapter do AgendaPort).
AGENDA_MOCK_DIAS_UTEIS=10
AGENDA_MOCK_HORA_INICIO=9
AGENDA_MOCK_HORA_FIM=20
AGENDA_MOCK_DURACAO_MIN=60

# --- CRM (Dia 3) ---
# Mock: tabela crm_registros + log JSON Lines (vazio = só tabela). Produção: HubSpot.
CRM_MOCK_LOG=var/crm_mock.jsonl

# --- Follow-up (Dia 3) — worker: docker compose up -d worker ---
# Cadência da vertical em dias (produção) ou minutos (demo: D+1, D+3, D+7 viram minutos)
FOLLOWUP_UNIDADE=dias
# Fora do horário de atendimento, adia para a próxima abertura
FOLLOWUP_RESPEITAR_HORARIO=true
# Worker: espera entre varreduras sem trabalho e itens por varredura
FOLLOWUP_INTERVALO_SEGUNDOS=5
FOLLOWUP_LOTE=20
# Lembrete do agendamento, tantas horas antes
FOLLOWUP_LEMBRETE_HORAS=24
# Depois disso sem o lead falar, mensagem ativa exige template (WhatsApp)
JANELA_CONVERSA_HORAS=24
# Espera máxima na fila do humano (minutos úteis) antes do alerta HandoffSLAExcedido
HANDOFF_SLA_MINUTOS=15

# --- Canal WhatsApp (Dia 4) — meta | twilio; vazio = desligado (webhook 404) ---
WHATSAPP_PROVEDOR=
# Meta (Cloud API): developers.facebook.com → app com WhatsApp → Configuração da API
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# Configurações do app → Básico → Chave secreta (assinatura X-Hub-Signature-256)
META_APP_SECRET=
# Qualquer texto; o mesmo no painel do webhook (handshake)
META_VERIFY_TOKEN=
META_VERSAO_GRAPH=v22.0
# Só desligue em teste local controlado
META_VALIDAR_ASSINATURA=true
# URL pública da API — base da assinatura X-Twilio-Signature e dos callbacks.
# Local: o túnel (https://xxxx.trycloudflare.com). Nuvem: https://<domínio da api na
# Railway>, o mesmo do webhook da Meta/Twilio (docs/deploy.md, passo 6). Sem "/" no fim.
PUBLIC_BASE_URL=
TWILIO_ACCOUNT_SID=
# NUNCA commitar
TWILIO_AUTH_TOKEN=
# Número do Sandbox (ou o número aprovado em produção)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Só desligue em teste local controlado (sem assinatura, qualquer um posta no webhook)
TWILIO_VALIDAR_ASSINATURA=true
# Limite por mensagem; acima disso a resposta é dividida (vazio = Twilio 1600, Meta 4096)
WHATSAPP_LIMITE_CARACTERES=
# Nome lógico (da vertical) → template aprovado. JSON numa linha; ordem = {{1}}, {{2}}...
# Twilio usa "content_sid"; Meta usa "nome" (do template aprovado; padrão = nome lógico).
# Ex.: {"imob_lembrete_agendamento":{"content_sid":"HX...","idioma":"pt_BR","variaveis":["primeiro_nome","compromisso","com_quem","quando","onde"]}}
# Textos para aprovação: docs/whatsapp-templates.md
WHATSAPP_TEMPLATES={}
# Validador de variáveis de template (tamanho máximo)
TEMPLATE_VARIAVEL_MAX_CARACTERES=200

# --- Observabilidade (Dia 4) — Langfuse; sem as chaves, nada é enviado (no-op) ---
# cloud.langfuse.com (EU) ou us.cloud.langfuse.com (US): Settings → API Keys
LANGFUSE_PUBLIC_KEY=
# NUNCA commitar
LANGFUSE_SECRET_KEY=
# Região da conta (LANGFUSE_HOST também é aceito)
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Segurança (Dia 5 — ADR 015 e docs/seguranca.md) ---
# Chave(s) do header X-API-Key das rotas administrativas/de atendimento (painel, leads,
# fila, agenda, LGPD, demo), separadas por vírgula. Gere com: openssl rand -hex 32
# Vazio: em AMBIENTE=local as rotas ficam abertas (aviso no log); em producao a API não sobe.
# NUNCA commitar. O dashboard usa a primeira da lista para falar com a API.
ADMIN_API_KEYS=
# Login do dashboard (Streamlit). Hash: uv run python -m sdr.cli hash-senha
DASHBOARD_USUARIO=
DASHBOARD_SENHA_HASH=
# Alternativa SÓ para local: senha em texto (ignorada se houver o hash)
DASHBOARD_SENHA=
# Tamanho máximo da mensagem do lead (web acima disso = 422; WhatsApp é truncado)
MENSAGEM_MAX_CARACTERES=2000
# Rate limit por minuto (0 = desligado). Por remetente vale no chat e nos webhooks.
LIMITE_REMETENTE_POR_MINUTO=20
LIMITE_IP_POR_MINUTO=60
# No webhook o IP é o do provedor (Twilio/Meta): limite alto, só contra flood
LIMITE_IP_WEBHOOK_POR_MINUTO=600
# true atrás de proxy (Railway/Render): o IP do cliente vem do X-Forwarded-For
CONFIAR_PROXY=false

# --- Dashboard (serviço web) ---
# Onde o Streamlit encontra a API. Compose: http://api:8000 (já definido no compose).
# Nuvem: a URL pública da api (https://<domínio da api>).
# API_URL=http://localhost:8000
# Chave que o dashboard manda no X-API-Key (vazio = 1ª de ADMIN_API_KEYS)
# API_KEY=
