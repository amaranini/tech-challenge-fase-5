# Copie para .env e ajuste. NUNCA commite o .env.

AMBIENTE=local
LOG_LEVEL=INFO

# Postgres (docker compose)
POSTGRES_USER=sdr
POSTGRES_PASSWORD=sdr
POSTGRES_DB=sdr
DB_PORT=5433

# Usado pela API/migrations/testes rodando no host.
# Dentro do compose a API recebe a URL apontando para o serviço "db".
DATABASE_URL=postgresql+psycopg://sdr:sdr@localhost:5433/sdr

# Portas expostas no host
API_PORT=8000
WEB_PORT=8501

# Embeddings locais (fastembed). Trocar o modelo para outra dimensão exige migration.
EMBEDDING_MODELO=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSAO=384
EMBEDDING_CACHE_DIR=.cache/fastembed

# Vertical de negócio ativa
VERTICAL=imobiliario

# --- Vertical imobiliária (prefixo IMOBILIARIO_) ---
# O que "perto do metrô" significa na busca (metros)
IMOBILIARIO_DISTANCIA_METRO_PADRAO_M=1000

# --- LLM (Etapa C) ---
# Provedor do LLMPort (hoje: openai)
LLM_PROVIDER=openai
# Modelo com suporte a tool calling; confira os disponíveis na sua conta
LLM_MODELO=gpt-4.1-mini
# Modelo por nó do grafo (vazio = usa LLM_MODELO)
LLM_MODEL_ROUTER=
LLM_MODEL_EXTRACTION=
LLM_MODEL_AGENT=
# Turnos assíncronos: espera o lead parar de digitar (reinicia a cada mensagem), com teto
DEBOUNCE_SEGUNDOS=5
DEBOUNCE_MAX_SEGUNDOS=20
# Confiança mínima do roteador para trocar de intenção
ROUTER_CONFIANCA_MIN=0.6
LLM_TEMPERATURA=0.4
# Chave da OpenAI (https://platform.openai.com/api-keys) — NUNCA commitar
OPENAI_API_KEY=

# --- Operação (vale para qualquer vertical) ---
FUSO_OPERACAO=America/Sao_Paulo

# --- Agenda (Dia 3) ---
# Não oferece horário mais próximo que N horas, nem além de N dias
AGENDA_ANTECEDENCIA_HORAS=2
AGENDA_JANELA_DIAS=14
AGENDA_SUGESTOES=3
# Agenda mock (Postgres): grade gerada no start da API e no `make seed`.
# Em produção: Google Calendar / Outlook (troca-se o adapter do AgendaPort).
AGENDA_MOCK_DIAS_UTEIS=10
AGENDA_MOCK_HORA_INICIO=9
AGENDA_MOCK_HORA_FIM=20
AGENDA_MOCK_DURACAO_MIN=60
